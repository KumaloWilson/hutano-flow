# Files used inside Linux containers keep LF on every platform (Git for Windows would
# otherwise check them out with CRLF, and Postgres would fail to run init_database.sh).
* text=auto
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
.env.example text eol=lf
# Windows launchers
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Binary evidence
*.png binary
*.xml text
