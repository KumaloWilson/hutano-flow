POSTGRES_DB=hutano_flow
POSTGRES_USER=hutano
POSTGRES_PASSWORD=change-this-local-password
APP_DB_PASSWORD=change-this-app-password
DATABASE_URL=postgresql+psycopg://hutano_app:change-this-app-password@db:5432/hutano_flow
MIGRATION_DATABASE_URL=postgresql+psycopg://hutano:change-this-local-password@db:5432/hutano_flow
SECRET_KEY=replace-with-at-least-32-random-characters
RESEARCH_MODE=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
# Empty uses the web server proxy, so browser API requests work from any configured demo host.
NEXT_PUBLIC_API_URL=
MODEL_ARTIFACT_DIR=/app/artifacts

# Sessions: idle timeout (shared reception PCs) inside an absolute lifetime, in minutes.
SESSION_IDLE_MINUTES=30
SESSION_MINUTES=480
# Proxies allowed to forward the real client IP (web container / LAN TLS proxy network).
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
# Host-side only (read by scripts/backup_demo.sh, never by containers):
# BACKUP_PASSPHRASE_FILE=/home/you/.config/hutano/backup-passphrase
# REQUIRE_BACKUP_ENCRYPTION=1
# Fictional clinic preparation at boot (migrate service). true keeps its accounts working on
# first start and refreshes a rehearsal older than 8 hours.
PREPARE_SHOWCASE=true
# true records a clearly labelled *scripted* review and enables the trained demo advisory
# (fictional clinic only; ADR-038). Leave false to show the clinician review step live.
SHOWCASE_REVIEWED_ADVISORY=false
